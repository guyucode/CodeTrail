{
  "name": "codetrail-reader",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Local, read-only feature-oriented code reader built with Rust, Tauri and Monaco",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "test": "vitest run",
    "test:ui": "node scripts/smoke-ui.mjs",
    "test:native": "node scripts/smoke-native.mjs",
    "test:native:managed": "node scripts/run-native.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "doctor": "node scripts/doctor.mjs",
    "demo:init": "node scripts/init-demo.mjs",
    "test:collaboration:ui": "node scripts/smoke-collaboration.mjs"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "lucide-react": "1.64.0",
    "monaco-editor": "0.57.0",
    "pyright": "1.1.414",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
